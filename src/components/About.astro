---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EnergyFlow from './EnergyFlow.astro';

// Drop a photo at src/assets/kenny.jpg (or .jpeg/.png/.webp) and it replaces the placeholder.
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/kenny.{jpg,jpeg,png,webp}', { eager: true }),
)[0];
const photo = found?.default;
---

<section id="about" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl items-start gap-12 px-4 py-20 sm:px-6 md:py-24 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
    <div class="grid gap-8 sm:grid-cols-[170px_1fr]">
      {
        photo ? (
          <Image
            src={photo}
            alt="Kenny Picavet"
            widths={[200, 400]}
            sizes="170px"
            class="photo cut-corner aspect-[4/5] w-full max-w-[170px] object-cover"
          />
        ) : (
          <div class="photo cut-corner grid aspect-[4/5] w-full max-w-[170px] place-items-center bg-surface" aria-hidden="true">
            <img src="/logo.svg" alt="" width="36" height="48" class="h-12 w-auto opacity-30" />
          </div>
        )
      }
      <div class="max-w-[60ch]">
        <h2 class="mb-6 text-3xl font-extrabold tracking-tight md:text-4xl">About me</h2>
        <div class="space-y-4 text-lg leading-relaxed text-muted">
          <p>I’m Kenny, a developer from Beveren and a father of two.</p>
          <p>
            I started in 2012 in a team of three that later became Rydoo, and stayed for ten years. Since
            2022 I work as a freelancer, under my own company Picavet IT.
          </p>
          <p>
            At home I’m my own client. The house runs on Home Assistant: the solar panels, charging the
            car, heating and cooling, the lights. I designed the dashboards myself and set up the AI that
            helps me maintain it, with strict rules about what it may change. A lot of what I now do at
            clients, I tried there first.
          </p>
        </div>
      </div>
    </div>

    <EnergyFlow />
  </div>
</section>

<style>
  .photo {
    --cut: 28px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
