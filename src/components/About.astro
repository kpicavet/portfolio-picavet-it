---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Drop a photo at src/assets/kenny.jpg (or .jpeg/.png/.webp) and it replaces the placeholder.
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/kenny.{jpg,jpeg,png,webp}', { eager: true }),
)[0];
const photo = found?.default;

const lookingFor = [
  'Freelance projects in Angular and .NET, ideally across both the frontend and the backend.',
  'Teams that want to start working with AI properly: with guardrails, reviews and real output.',
  'Remote or hybrid, in Flanders. I work in Dutch and English.',
];
---

<section id="about" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-20 sm:px-6 md:grid-cols-[1.4fr_1fr] md:gap-12 lg:grid-cols-[1.9fr_1fr] md:py-24">
    <div class="grid gap-8 sm:grid-cols-[180px_1fr] lg:grid-cols-[220px_1fr]">
      {
        photo ? (
          <Image
            src={photo}
            alt="Kenny Picavet"
            widths={[220, 440]}
            sizes="220px"
            class="photo cut-corner aspect-[4/5] w-full max-w-[220px] object-cover"
          />
        ) : (
          <div class="photo cut-corner grid aspect-[4/5] w-full max-w-[220px] place-items-center bg-surface" aria-hidden="true">
            <img src="/logo.svg" alt="" width="36" height="48" class="h-12 w-auto opacity-30" />
          </div>
        )
      }
    <div class="max-w-[62ch]">
      <h2 class="mb-6 text-3xl font-extrabold tracking-tight md:text-4xl">About me</h2>
      <div class="space-y-4 text-lg leading-relaxed text-muted">
        <p>
          I’m Kenny. I live in Beveren with my family and I’m a father of two. I studied Applied
          Informatics at Karel de Grote in Antwerp.
        </p>
        <p>
          In 2012 I joined a team of three building what became Rydoo. Ten years there taught me how to
          ship a product, and how to keep a codebase healthy while the team around it keeps growing.
          Since 2022 I work as a freelancer under my own company, Picavet IT.
        </p>
        <p>
          Outside work my house is my lab: if a new way of working with AI holds up at home, it’s ready
          for a client.
        </p>
      </div>
    </div>
    </div>

    <aside class="looking cut-corner bg-mint p-7 text-[#1d2a26] md:mt-16 md:p-9">
      <h3 class="text-xl font-bold">What I’m looking for</h3>
      <ul class="mt-5 space-y-4 leading-relaxed">
        {lookingFor.map((item) => <li class="item">{item}</li>)}
      </ul>
      <a href="#contact" class="mt-7 inline-block font-semibold underline decoration-2 underline-offset-4">
        Tell me about your project
      </a>
    </aside>
  </div>
</section>

<style>
  .photo {
    --cut: 32px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .looking {
    --cut: 52px;
    padding-bottom: calc(2.25rem + 18px);
  }
  .item {
    position: relative;
    padding-left: 1.1rem;
  }
  .item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 10px;
    background: #1d2a26;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2.3px), 0 100%);
  }
</style>
