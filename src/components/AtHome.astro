---
/**
 * What Kenny builds outside work. Deliberately general: no security details,
 * names or addresses. Always dark, like the dashboards it describes.
 */
const tiles = [
  {
    icon: 'home',
    title: 'A house that mostly runs itself',
    body: 'Home Assistant on a Raspberry Pi: solar forecast, EV charging that keeps the house under its peak-power limit, five climate zones, lighting, blinds, the pool and the family calendar.',
  },
  {
    icon: 'tablet',
    title: 'Dashboards I designed',
    body: 'A full set of wall-tablet and mobile dashboards in my own dark theme, with a shared navigation component and a script that audits every layout on tablet and at phone width.',
  },
  {
    icon: 'shield',
    title: 'An AI workflow with guardrails',
    body: 'Claude Code does the heavy lifting inside rules I wrote: eleven skills, read-only review agents, and hooks that block unsafe changes before they reach the house. Every change gets a rollback snapshot and a weekly review.',
  },
  {
    icon: 'plane',
    title: 'Reis Uitgaven',
    body: 'A small travel-expense app for two, built with Angular and Firebase and deployed on Netlify.',
  },
];

const icons: Record<string, string> = {
  home: 'M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5M10 20v-5h4v5',
  tablet: 'M5 3.5h14a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V5A1.5 1.5 0 0 1 5 3.5ZM8 8h8M8 12h5M8 16h3',
  shield: 'M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6L12 3ZM9 12l2 2 4-4',
  plane: 'M10.5 13.5 3 11l1.5-1.5 8 1 4-4c1-1 2.5-1 3 0 .5.5.5 2-.5 3l-4 4 1 8L14 23l-2.5-7.5-3 3V21l-1.5 1-1-3.5-3.5-1 1-1.5h2.5l3-3Z',
};
---

<section id="home-lab" class="dark-band">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <div class="mb-10 max-w-[60ch]">
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">At home</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/70">
        I treat my own house like a product: versioned, reviewed and tested. It is also where I try out
        new ways of working with AI before I bring them to a client.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        tiles.map((t) => (
          <article class="tile cut-corner">
            <svg class="size-7 text-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[t.icon]} />
            </svg>
            <h3 class="mt-5 text-lg font-bold text-white">{t.title}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{t.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dark-band {
    background: #131515;
    color: #edefee;
  }
  .tile {
    --cut: 36px;
    background: #1d2121;
    padding: 1.75rem 1.75rem 2.5rem;
    box-shadow: inset 0 0 0 1px #2b3030;
  }
</style>
