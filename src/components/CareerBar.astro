---
/**
 * Career on a true time scale: every company is a segment whose width is its
 * duration. Red = employed, mint = freelance. The current role ends in the
 * same 30° cut as the stems of the logo.
 */
import { experience } from '../data/cv';
import { formatPeriod, toEndYear, toYear } from '../lib/dates';
import { slug } from '../lib/slug';

interface Props {
  compact?: boolean;
  /** draw the bar once on page load (respects reduced motion) */
  animate?: boolean;
  /** turn company labels into links to #job-<company> */
  linked?: boolean;
}
const { compact = false, animate = false, linked = false } = Astro.props;

// One segment per company (promotions are in the text; short role pieces read as glitches)
const segments = experience
  .map((job) => {
    const from = job.roles[job.roles.length - 1].period.from; // roles are newest first
    const to = job.roles[0].period.to;
    return {
      company: job.company,
      title: job.roles.map((r) => r.title).join(', '),
      freelance: Boolean(job.freelance),
      current: to === null,
      start: toYear(from),
      end: toEndYear(to),
      label: formatPeriod({ from, to }),
    };
  })
  .sort((a, b) => a.start - b.start);

// A break of a month or less carries no information but reads as a glitch: close it
for (let i = 1; i < segments.length; i++) {
  const gap = segments[i].start - segments[i - 1].end;
  if (gap > 0 && gap <= 1 / 12 + 1e-9) segments[i].start = segments[i - 1].end;
}

const first = Math.floor(segments[0].start);
const last = Math.max(...segments.map((s) => s.end));
const span = last - first;
const pct = (year: number) => ((year - first) / span) * 100;

// One label per company, only where there is room for it
const companies = experience
  .map((job) => ({
    name: job.company,
    start: Math.min(...job.roles.map((r) => toYear(r.period.from))),
    end: Math.max(...job.roles.map((r) => toEndYear(r.period.to))),
  }))
  .filter((c) => c.end - c.start >= 1.5)
  .sort((a, b) => a.start - b.start);

// keep ticks clear of the 'now' label at the end
const ticks = [first, 2016, 2021].filter((y) => y >= first && y < last - 1.5);

/*
  Labels and ticks are laid out in normal flow (a spacer, then each item as wide
  as the gap to the next one) instead of absolute positioning. Positioned text is
  painted late, which scrambles the reading order of the PDF for ATS parsers.
*/
const flowRow = (lefts: number[]) =>
  lefts.map((left, i) => (i < lefts.length - 1 ? `flex-basis:${lefts[i + 1] - left}%` : ''));
const labelStyles = flowRow(companies.map((c) => pct(c.start)));
const tickStyles = flowRow(ticks.map((y) => pct(y)));
---

<figure class:list={['career', { compact, animate }]}>
  <div class="track" aria-hidden="true">
    {
      segments.map((s) => (
        <span
          class:list={['seg', s.freelance ? 'free' : 'emp', { current: s.current }]}
          style={`left:${pct(s.start)}%;width:${pct(s.end) - pct(s.start)}%;--d:${(pct(s.start) / 100) * 0.9}s`}
          title={`${s.title}, ${s.company} (${s.label})`}
        />
      ))
    }
  </div>
  <div class="labels">
    <span class="spacer" style={`flex-basis:${pct(companies[0].start)}%`}></span>
    {
      companies.map((c, i) => (
        <span class:list={['slot', { last: i === companies.length - 1 }]} style={labelStyles[i]}>
          {linked ? <a href={`#job-${slug(c.name)}`}>{c.name}</a> : <span aria-hidden="true">{c.name}</span>}
        </span>
      ))
    }
  </div>
  <div class="ticks" aria-hidden="true">
    {ticks.map((y, i) => <span class:list={['slot', { fill: i === ticks.length - 1 }]} style={tickStyles[i]}>{y}</span>)}
    <span class="slot end">now</span>
  </div>
  <figcaption class="sr-only">
    Career timeline. {segments.map((s) => `${s.title} at ${s.company}, ${s.label}.`).join(' ')}
  </figcaption>
</figure>

<style>
  .career {
    --h: 18px;
    --slant: calc(var(--h) * 0.577); /* tan 30° */
    margin: 0;
  }
  .career.compact {
    --h: 8px;
  }
  .track {
    position: relative;
    height: var(--h);
  }
  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    /* thin gap at the start of every role, so each change (incl. promotions)
       shows the same 2px seam; wider gaps are real time off between jobs */
    border-left: 2px solid var(--paper, #fff);
  }
  .seg:first-child {
    border-left: 0;
  }
  .emp {
    background: var(--red, #ac3931);
  }
  .free {
    background: var(--mint, #7fd1b9);
  }
  .current {
    /* the 30° cut is painted over with the page colour (no clip-path: keeps PDF text order intact) */
  }
  .current::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: var(--slant);
    height: 100%;
    background: linear-gradient(to bottom right, transparent 50%, var(--paper, #fff) 50%);
  }
  .labels,
  .ticks {
    display: flex;
    height: 1.6em;
  }
  /* slots may shrink (never below their text) so the last label always fits */
  .spacer,
  .slot {
    flex: 0 1 auto;
    min-width: 0;
    white-space: nowrap;
  }
  .slot {
    min-width: max-content;
  }
  .spacer {
    min-width: 0;
  }
  .ticks .fill {
    flex: 1 1 auto;
  }
  .labels {
    padding-top: 0.4em;
    font-weight: 650;
  }
  .labels .last {
    flex: 1 0 auto;
    text-align: right;
  }
  .labels a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line, #d5ded9);
    text-underline-offset: 3px;
  }
  .labels a:hover {
    text-decoration-color: currentColor;
  }
  .ticks {
    padding-top: 0.25em;
    color: var(--muted, #56655f);
    font-variant-numeric: tabular-nums;
  }
  .ticks .end {
    flex: none;
  }
  .compact .labels,
  .compact .ticks {
    font-size: 8pt;
  }

  @media (prefers-reduced-motion: no-preference) {
    .animate .seg {
      transform-origin: left center;
      animation: draw 0.35s cubic-bezier(0.3, 0.7, 0.4, 1) var(--d) both;
    }
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
