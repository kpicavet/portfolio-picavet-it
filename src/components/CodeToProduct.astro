---
/**
 * "From code to product", in three phases that follow the hero sentence
 * ("I build the frontend / the backend / the AI workflow around them"):
 * each phase shows the code for that layer appearing line by line, then the
 * result it produces. Hero.astro drives the phases; without JS the first
 * phase is shown complete.
 */
const phases = [
  {
    id: 'frontend',
    file: 'developer.component.ts',
    icon: '/tech-angular.svg',
    lines: [
      `<span class="k">@Component</span>({`,
      `  selector: <span class="s">'app-developer'</span>,`,
      `  template: <span class="s">\`&lt;h3&gt;{{ name }}&lt;/h3&gt; …\`</span>,`,
      `})`,
      `<span class="k">export class</span> <span class="t">DeveloperComponent</span> {`,
      `  name = <span class="s">'Kenny Picavet'</span>;`,
      `  stack = <span class="f">signal</span>([<span class="s">'Angular'</span>, <span class="s">'.NET'</span>, <span class="s">'AI'</span>]);`,
      `}`,
    ],
  },
  {
    id: 'backend',
    file: 'DeveloperController.cs',
    icon: '/tech-csharp.svg',
    lines: [
      `[<span class="t">ApiController</span>]`,
      `[<span class="t">Route</span>(<span class="s">"api/developer"</span>)]`,
      `<span class="k">public class</span> <span class="t">DeveloperController</span> : <span class="t">ControllerBase</span>`,
      `{`,
      `    [<span class="t">HttpGet</span>]`,
      `    <span class="k">public</span> <span class="t">Developer</span> <span class="f">Get</span>() =&gt;`,
      `        <span class="k">new</span>(<span class="s">"Kenny Picavet"</span>, [<span class="s">"Angular"</span>, <span class="s">".NET"</span>, <span class="s">"AI"</span>]);`,
      `}`,
    ],
  },
  {
    id: 'ai',
    file: '.claude/skills/rebuild-screen/SKILL.md',
    icon: '/tech-claude.svg',
    lines: [
      `<span class="c">---</span>`,
      `<span class="t">name</span>: rebuild-screen`,
      `<span class="t">description</span>: Rebuild a screen in Angular`,
      `<span class="c">---</span>`,
      `<span class="f">1.</span> Analyse the old screen and its API`,
      `<span class="f">2.</span> Build it with standalone components`,
      `<span class="f">3.</span> Write the tests`,
      `<span class="f">4.</span> Hand it to Kenny for review`,
    ],
  },
];
---

<div class="c2p" data-c2p>
  {
    phases.map((p, i) => (
      <div class:list={['phase', { on: i === 0 }]} data-phase={p.id}>
        <figure class="code" aria-label={`Example code: ${p.file}`}>
          <figcaption class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-3 text-sm text-white/60">
            <span class="truncate">{p.file}</span>
            <img src={p.icon} alt="" width="16" height="16" class="h-4 w-4 flex-none" />
          </figcaption>
          <pre class="px-5 py-4"><code>{p.lines.map((l, j) => <span class="line" style={`--i:${j}`} set:html={l} />)}</code></pre>
        </figure>

        <div class="card cut-corner" aria-hidden="true">
          {p.id === 'frontend' && (
            <>
              <span class="avatar">KP</span>
              <div class="min-w-0">
                <p class="font-bold">Kenny Picavet</p>
                <p class="mt-1.5 flex flex-wrap gap-1.5">
                  <span class="chip">Angular</span><span class="chip">.NET</span><span class="chip">AI</span>
                </p>
              </div>
            </>
          )}
          {p.id === 'backend' && (
            <div class="min-w-0">
              <p class="flex items-center gap-2 text-sm">
                <span class="ok">200 OK</span>
                <span class="text-[#1d2a26]/60">GET /api/developer</span>
              </p>
              <p class="mt-2 font-mono text-[0.82rem] leading-snug">
                {'{ "name": "Kenny Picavet", "stack": ["Angular", ".NET", "AI"] }'}
              </p>
            </div>
          )}
          {p.id === 'ai' && (
            <>
              <span class="avatar">KP</span>
              <div class="min-w-0">
                <p class="font-bold">Ready for review</p>
                <p class="mt-1 text-sm text-[#1d2a26]/65">Analysed, built and tested. Over to Kenny.</p>
              </div>
            </>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  /* min-width: 0 everywhere so long code lines scroll inside the window
     instead of widening the page on small screens */
  .c2p {
    display: grid;
    min-width: 0;
  }
  /* all phases share one grid cell, so switching never changes the height */
  .phase {
    grid-area: 1 / 1;
    min-width: 0;
    position: relative;
    padding-bottom: 5.25rem;
    visibility: hidden;
  }
  .phase.on {
    visibility: visible;
  }
  .code {
    margin: 0;
    background: #1f2937;
    border-radius: 10px;
    box-shadow:
      inset 0 0 0 1px #374151,
      0 20px 40px -20px rgb(0 0 0 / 0.6);
  }
  pre {
    margin: 0;
    overflow-x: auto;
    font: clamp(0.72rem, 2.6vw, 0.84rem) / 1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: #e5e7eb;
  }
  .line {
    display: block;
    white-space: pre;
  }
  .code :global(.k) {
    color: #f08a82;
  }
  .code :global(.s) {
    color: #7fd1b9;
  }
  .code :global(.t) {
    color: #f5c451;
  }
  .code :global(.f) {
    color: #8ab4f8;
  }
  .code :global(.c) {
    color: #6b7280;
  }

  .card {
    --cut: 24px;
    position: absolute;
    right: -0.75rem;
    bottom: 0;
    width: min(90%, 23rem);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem 1.15rem;
    background: #f3f6f4;
    color: #1d2a26;
    box-shadow: 0 18px 36px -14px rgb(0 0 0 / 0.55);
  }
  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #ac3931;
    color: #fff;
    font-weight: 800;
  }
  .chip {
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    background: rgb(127 209 185 / 0.35);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .ok {
    padding: 0.05rem 0.45rem;
    border-radius: 4px;
    background: #7fd1b9;
    font-weight: 700;
  }

  /* each time a phase comes on, its code types in and then the result appears */
  @media (prefers-reduced-motion: no-preference) {
    .phase.play .line {
      opacity: 0;
      transform: translateX(-6px);
      animation: type-in 0.3s ease-out forwards;
      animation-delay: calc(var(--i) * 0.16s + 0.1s);
    }
    .phase.play .card {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
      animation: render 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 1.55s forwards;
    }
  }
  @keyframes type-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes render {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
