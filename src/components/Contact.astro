---
import { profile } from '../data/cv';

const field =
  'mt-1.5 w-full rounded-md border-0 bg-white px-3 py-2.5 text-[#1d2a26] focus:outline-2 focus:outline-offset-2 focus:outline-white';
---

<section id="contact" class="bg-red text-white [--accent-text:#fff]">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 md:gap-16 md:py-28">
    <div>
      <h2 class="mb-6 text-3xl font-extrabold tracking-tight md:text-4xl">Get in touch</h2>
      <p class="max-w-[46ch] text-lg leading-relaxed text-white/85">
        I work with companies directly and through agencies. Tell me about the project and the team, and
        I’ll get back to you.
      </p>

      <a
        href={`mailto:${profile.email}`}
        class="mt-8 inline-block text-[clamp(1.35rem,3vw,2rem)] font-bold break-all text-white underline decoration-2 underline-offset-[6px]"
      >
        {profile.email}
      </a>

      <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
        <dt class="text-white/70">Phone</dt>
        <dd><a href={`tel:${profile.phone.replace(/\s/g, '')}`} class="hover:underline">{profile.phone}</a></dd>
        <dt class="text-white/70">LinkedIn</dt>
        <dd><a href={profile.linkedin} class="hover:underline" target="_blank" rel="noopener noreferrer">kenny-picavet</a></dd>
      </dl>
    </div>

    <form id="contact-form" class="space-y-5" novalidate>
      <p class="hidden" aria-hidden="true">
        <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div>
        <label for="name" class="font-semibold">Name</label>
        <input id="name" name="name" required autocomplete="name" class={field} />
      </div>
      <div>
        <label for="email" class="font-semibold">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class={field} />
      </div>
      <div>
        <label for="message" class="font-semibold">Message</label>
        <textarea id="message" name="message" rows="5" required class={field}></textarea>
      </div>
      <button
        type="submit"
        class="rounded-md bg-[#1d2a26] px-5 py-3 font-semibold text-white hover:bg-black disabled:cursor-wait disabled:opacity-60"
      >
        Send message
      </button>
      <p id="form-status" role="status" aria-live="polite" class="min-h-6"></p>
    </form>
  </div>
</section>

<script>
  // EmailJS free plan: 200 mails/month, it simply stops at the limit, never bills.
  // These IDs are public by design (EmailJS "public key"), safe in client code.
  const EMAILJS = {
    service_id: 'service_8gdbn61',
    template_id: 'template_wszk2dn',
    user_id: 'MX7u3gScb5h4Z8-oG',
  };

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const show = (text: string, ok: boolean) => {
    if (!status) return;
    status.textContent = text;
    status.className = ok ? 'min-h-6 font-semibold text-white' : 'min-h-6 font-semibold text-white underline';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    // bots fill the hidden field; pretend success and send nothing
    if ((form.elements.namedItem('company-website') as HTMLInputElement)?.value) {
      form.reset();
      show('Message sent. I’ll reply by email.', true);
      return;
    }

    const data = new FormData(form);
    data.delete('company-website');
    Object.entries(EMAILJS).forEach(([key, value]) => data.append(key, value));

    if (button) button.disabled = true;
    show('Sending…', true);
    try {
      const response = await fetch('https://api.emailjs.com/api/v1.0/email/send-form', { method: 'POST', body: data });
      if (!response.ok) throw new Error(`EmailJS ${response.status}: ${await response.text()}`);
      form.reset();
      show('Message sent. I’ll reply by email.', true);
    } catch (error) {
      // the reason is logged for debugging (browser console), the visitor gets a way out
      console.error('Contact form failed:', error);
      show('The message couldn’t be sent. Email me directly at kenny@picavet-it.com.', false);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
