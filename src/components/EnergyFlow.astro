---
/**
 * A small card in the style of Kenny's own Home Assistant dashboards: energy
 * flowing from the solar panels to the house and on to the car. Illustrative,
 * no real data (and nothing about the house's security).
 */
const icon = {
  sun: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10ZM12 1.5v2.5M12 20v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M1.5 12H4M20 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8',
  home: 'M3.5 11 12 4l8.5 7M6 9.5V20h12V9.5M10 20v-5h4v5',
  car: 'M5 16.5h14M6.5 16.5v2M17.5 16.5v2M4 16.5v-4l2-5h12l2 5v4M4 12.5h16M8 14.5h.01M16 14.5h.01',
  grid: 'M12 3 7 21M12 3l5 18M8.5 15h7M9.5 10h5M5 21h14',
};
---

<figure class="energy cut-corner" aria-label="Illustration: energy flowing from solar panels to the house and the car">
  <figcaption class="mb-4 flex items-center justify-between text-sm">
    <span class="font-semibold text-white">How my house runs</span>
    <span class="text-white/50">Home Assistant</span>
  </figcaption>

  <svg viewBox="0 0 300 210" class="w-full" aria-hidden="true">
    <!-- flows -->
    <path class="flow sun" d="M150 52 V102" />
    <path class="flow car" d="M178 130 H246" />
    <path class="flow idle" d="M122 130 H54" />

    <!-- nodes -->
    <g transform="translate(150 30)">
      <circle r="24" class="node sun" />
      <path d={icon.sun} transform="translate(-12 -12)" class="glyph" />
    </g>
    <g transform="translate(150 130)">
      <circle r="28" class="node home" />
      <path d={icon.home} transform="translate(-12 -12)" class="glyph" />
    </g>
    <g transform="translate(268 130)">
      <circle r="22" class="node car" />
      <path d={icon.car} transform="translate(-12 -12)" class="glyph" />
    </g>
    <g transform="translate(32 130)">
      <circle r="22" class="node grid" />
      <path d={icon.grid} transform="translate(-12 -12)" class="glyph" />
    </g>

    <text x="150" y="190" class="label">house</text>
    <text x="268" y="170" class="label">car</text>
    <text x="32" y="170" class="label">grid</text>
  </svg>
</figure>

<style>
  .energy {
    --cut: 34px;
    background: #111827;
    box-shadow: inset 0 0 0 1px #374151;
    padding: 1.4rem 1.5rem 1.9rem;
  }
  .node {
    fill: #1f2937;
    stroke-width: 2;
  }
  .node.sun {
    stroke: #f5c451;
  }
  .node.home {
    stroke: #7fd1b9;
  }
  .node.car {
    stroke: #7fd1b9;
  }
  .node.grid {
    stroke: #4b5563;
  }
  .glyph {
    fill: none;
    stroke: #f3f4f6;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 10;
  }
  .flow.sun {
    stroke: #f5c451;
  }
  .flow.car {
    stroke: #7fd1b9;
  }
  .flow.idle {
    stroke: #374151;
    stroke-dasharray: none;
  }
  .label {
    fill: #9ca3af;
    font-size: 12px;
    text-anchor: middle;
    font-family: inherit;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flow.sun,
    .flow.car {
      animation: flow 1.1s linear infinite;
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -12;
    }
  }
</style>
