---
import { experience } from '../data/cv';
import { formatPeriod } from '../lib/dates';
import { slug } from '../lib/slug';
---

<section id="experience" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <div class="mb-12 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">Experience</h2>
      <a href="/kenny-picavet-cv.pdf" download class="font-semibold text-accent-text underline underline-offset-4">
        Download CV (PDF)
      </a>
    </div>

    <ol class="divide-y divide-line">
      {
        experience.map((job) => (
          <li id={`job-${slug(job.company)}`} class="grid gap-4 py-10 first:pt-0 md:grid-cols-[1fr_2fr] md:gap-16">
            <div>
              <h3 class="text-2xl font-bold tracking-tight">
                {job.url ? (
                  <a href={job.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {job.company}
                  </a>
                ) : (
                  job.company
                )}
              </h3>
              <p class="mt-1 text-muted">
                {job.location}
                {job.freelance && <span class="ml-2 rounded-sm bg-mint/25 px-1.5 py-0.5 text-sm text-ink">Freelance</span>}
              </p>
            </div>

            <div class="max-w-[66ch]">
              <ul class="mb-4 space-y-1">
                {job.roles.map((role) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                    <span class="font-semibold">{role.title}</span>
                    <span class="text-sm text-muted tabular-nums">{formatPeriod(role.period)}</span>
                  </li>
                ))}
              </ul>
              <p class="leading-relaxed">{job.summary}</p>
              {job.highlights.length > 0 && (
                <ul class="mt-4 space-y-2 leading-relaxed text-muted">
                  {job.highlights.map((h) => (
                    <li class="hl">{h}</li>
                  ))}
                </ul>
              )}
              <p class="mt-4 text-sm text-mint-deep">{job.stack.join(', ')}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hl {
    position: relative;
    padding-left: 1.1rem;
  }
  .hl::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 9px;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2.3px), 0 100%);
  }
</style>
