---
import { expertise } from '../data/site';

const icons: Record<string, string> = {
  layers: 'M12 3.5 3.5 8 12 12.5 20.5 8 12 3.5ZM3.5 12 12 16.5 20.5 12M3.5 16 12 20.5 20.5 16',
  rocket: 'M14 4c3.5 0 6 2.5 6 6-1.5 3-4.5 6-8 7.5L9.5 15C11 11.5 14 7 14 4ZM9.5 15l-3 .5 2-4M12 17.5l-.5 3 4-2M15.5 9.5h.01',
  layout: 'M4 4.5h16v15H4zM4 9h16M9 9v10.5',
  server: 'M4.5 4.5h15v6h-15zM4.5 13.5h15v6h-15zM8 7.5h.01M8 16.5h.01',
  compass: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM15.5 8.5l-2 5-5 2 2-5 5-2Z',
  spark: 'M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.8 2.8M14.9 14.9l2.8 2.8M6.3 17.7l2.8-2.8M14.9 9.1l2.8-2.8',
};
const tones = ['bg-mint text-[#1d2a26]', 'bg-red text-white', 'bg-ink text-paper', 'bg-red text-white', 'bg-mint text-[#1d2a26]'];
---

<section id="work" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <h2 class="mb-10 text-3xl font-extrabold tracking-tight md:text-4xl">Expertise</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        expertise.map((e, i) => (
          <article class="card cut-corner bg-surface p-6 pb-9">
            <span class:list={['grid size-11 place-items-center rounded-md', tones[i % tones.length]]} aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[e.icon]} />
              </svg>
            </span>
            <h3 class="mt-5 text-lg font-bold">{e.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{e.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .card {
    --cut: 32px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.2s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-4px);
    }
  }
</style>
