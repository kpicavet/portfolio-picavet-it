---
import CareerBar from './CareerBar.astro';
import { profile } from '../data/cv';
---

<section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 md:pt-24 md:pb-28">
  <h1 class="text-[clamp(2.75rem,8vw,6rem)] leading-[0.95] font-extrabold tracking-[-0.03em]">
    {profile.name}
  </h1>
  <p class="mt-6 max-w-[34ch] text-[clamp(1.25rem,2.4vw,1.75rem)] leading-snug font-medium">
    Senior Angular &amp; .NET engineer. Freelance, based in Belgium.
  </p>
  <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-muted">
    I’ve been building web products for fifteen years. Ten of them at Rydoo, where I grew with the
    product from a team of three to an international scale-up. Since 2022 I work freelance, now at
    Citymesh on both the backend and the frontend.
  </p>

  <div class="mt-9 flex flex-wrap gap-3">
    <a
      href={`mailto:${profile.email}`}
      class="rounded-md bg-red px-5 py-3 font-semibold text-white hover:bg-[#962f28]"
    >
      Email me
    </a>
    <a href="/cv" class="rounded-md border border-ink/25 px-5 py-3 font-semibold hover:border-ink">
      View CV
    </a>
  </div>

  <div class="mt-20 text-sm md:mt-24">
    <CareerBar animate linked />
    <p class="mt-1 flex items-center gap-4 text-xs text-muted">
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-3 bg-red"></span>Employed</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-3 bg-mint"></span>Freelance</span>
    </p>
  </div>
</section>
