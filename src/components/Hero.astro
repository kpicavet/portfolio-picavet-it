---
import { profile } from '../data/cv';

const facts = ['15+ years', 'Angular & .NET', 'Freelance, Belgium'];
---

<section class="hero relative overflow-hidden text-white">
  <!-- the logo, large and partly off-canvas; it assembles once on load -->
  <svg class="mark" viewBox="0 0 100 133.64" aria-hidden="true">
    <path class="bowl" fill="#ac3931" d="M0 0H50A50 50 0 0 1 60 98.99L40 110.54V80H50A30 30 0 0 0 50 20H0Z" />
    <path class="stem" fill="#7fd1b9" d="M0 40H50A10 10 0 0 1 50 60H20V122.1L0 133.64Z" />
  </svg>

  <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-24 sm:px-6 md:pt-28 md:pb-32">
    <div class="max-w-[40rem]">
      <h1 class="text-[clamp(3rem,9vw,7rem)] leading-[0.92] font-extrabold tracking-[-0.035em]">
        {profile.name}
      </h1>
      <p class="mt-7 max-w-[30ch] text-[clamp(1.35rem,2.6vw,2rem)] leading-snug font-semibold">
        Senior Angular &amp; .NET engineer. I build the frontend, the backend, and lately the AI workflow around them.
      </p>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-white/70">
        Fifteen years of web products, ten of them at Rydoo, where I grew with the product from a team of
        three to an international scale-up. Freelance since 2022, now at Citymesh.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-md bg-red px-6 py-3.5 font-semibold text-white hover:bg-[#962f28]"
        >
          Email me
        </a>
        <a href="/cv" class="rounded-md border border-white/30 px-6 py-3.5 font-semibold hover:border-white">
          View CV
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-white/85">
        {
          facts.map((f) => (
            <li class="flex items-center gap-2.5 font-medium">
              <span class="size-2 bg-mint" aria-hidden="true" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #111827;
  }
  .mark {
    position: absolute;
    right: -9%;
    top: 50%;
    height: 96%;
    width: auto;
    transform: translateY(-50%);
  }
  @media (max-width: 900px) {
    .mark {
      right: -28%;
      top: 58%;
      height: 72%;
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bowl {
      animation: bowl-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
    }
    .stem {
      animation: stem-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.45s both;
    }
  }
  @keyframes bowl-in {
    from {
      transform: translateX(22px);
      opacity: 0;
    }
  }
  @keyframes stem-in {
    from {
      transform: translateY(26px);
      opacity: 0;
    }
  }
</style>
