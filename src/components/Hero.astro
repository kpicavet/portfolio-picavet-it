---
import StackLayers from './StackLayers.astro';
import { profile } from '../data/cv';

const builds = [
  { id: 'frontend', text: 'the frontend' },
  { id: 'backend', text: 'the backend' },
  { id: 'ai', text: 'the AI workflow around them' },
];
---

<section class="hero relative overflow-hidden text-white">
  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pt-20 pb-24 sm:px-6 md:pt-24 md:pb-28 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
    <div>
      <h1 class="text-[clamp(3rem,8.5vw,6.5rem)] leading-[0.92] font-extrabold tracking-[-0.035em]">
        {profile.name}
      </h1>
      <p class="mt-6 text-[clamp(1.2rem,2.2vw,1.6rem)] font-semibold text-white/80">
        Freelance Angular &amp; .NET developer from Beveren.
      </p>

      <p class="builds mt-8 text-[clamp(1.6rem,3.4vw,2.6rem)] leading-tight font-extrabold tracking-tight" data-builds>
        <span class="block text-white/55">I build</span>
        <span class="rotator">
          {
            builds.map((b, i) => (
              <span class:list={['word', { on: i === 0 }]} data-layer={b.id}>
                {b.text}
              </span>
            ))
          }
        </span>
      </p>

      <p class="mt-8 max-w-[50ch] text-lg leading-relaxed text-white/70">
        Fifteen years in web development, ten of them at Rydoo. Freelance since 2022, right now at
        Citymesh.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-md bg-red px-6 py-3.5 font-semibold text-white hover:bg-[#962f28]"
        >
          Email me
        </a>
        <a href="/cv" class="rounded-md border border-white/30 px-6 py-3.5 font-semibold hover:border-white">
          View CV
        </a>
      </div>
    </div>

    <StackLayers />
  </div>
</section>

<style>
  .hero {
    background: #111827;
  }
  /* all words share one grid cell, so the line never jumps in height */
  .rotator {
    display: grid;
  }
  .word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.4s,
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .word.on {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .word {
      transition: none;
    }
  }
</style>

<script>
  // The sentence and the stack move together: every few seconds the next layer
  // comes forward. Clicking a layer picks it and pauses the cycle.
  const words = [...document.querySelectorAll<HTMLElement>('[data-builds] .word')];
  const layers = [...document.querySelectorAll<HTMLButtonElement>('[data-stack] .layer')];
  const ids = words.map((w) => w.dataset.layer!);
  let index = 0;
  let timer: number | undefined;

  const show = (i: number) => {
    index = i;
    words.forEach((w, j) => w.classList.toggle('on', j === i));
    layers.forEach((l) => l.setAttribute('aria-pressed', String(l.dataset.layer === ids[i])));
  };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => {
    if (reduced) return;
    timer = window.setInterval(() => show((index + 1) % ids.length), 2800);
  };

  layers.forEach((l) =>
    l.addEventListener('click', () => {
      window.clearInterval(timer);
      show(ids.indexOf(l.dataset.layer!));
    }),
  );

  show(0);
  start();
</script>
