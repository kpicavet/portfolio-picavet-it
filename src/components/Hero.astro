---
import { profile } from '../data/cv';

const facts = [
  { label: 'Now', value: 'Citymesh: BSS platform, backend, frontend and the team’s AI workflow' },
  { label: 'Before', value: 'VAB (2022–⁠2024) and ten years at Rydoo (2012–⁠2022)' },
  { label: 'Works with', value: 'Angular, C# / .NET, Claude Code' },
  { label: 'Based in', value: 'Beveren, Belgium. Works in Dutch and English' },
];
---

<section class="mx-auto max-w-6xl px-4 pt-14 pb-20 sm:px-6 md:pt-20 md:pb-24">
  <div class="grid items-center gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
    <div>
      <h1 class="text-[clamp(2.75rem,7.5vw,5.75rem)] leading-[0.95] font-extrabold tracking-[-0.03em]">
        {profile.name}
      </h1>
      <p class="mt-6 max-w-[34ch] text-[clamp(1.3rem,2.4vw,1.8rem)] leading-snug font-semibold">
        Senior Angular &amp; .NET engineer. I build the frontend, the backend, and lately the AI workflow around them.
      </p>
      <p class="mt-4 max-w-[58ch] text-lg leading-relaxed text-muted">
        Fifteen years of web products, ten of them at Rydoo, where I grew with the product from a team of
        three to an international scale-up. Freelance since 2022.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-md bg-red px-5 py-3 font-semibold text-white hover:bg-[#962f28]"
        >
          Email me
        </a>
        <a href="/cv" class="rounded-md border border-ink/25 px-5 py-3 font-semibold hover:border-ink">
          View CV
        </a>
      </div>
    </div>

    <aside aria-label="At a glance" class="glance cut-corner bg-red p-7 text-white md:p-9">
      <p class="mb-6 flex items-center gap-3 text-lg font-bold">
        <img src="/logo.svg" alt="" width="18" height="24" class="h-6 w-auto brightness-0 invert" />
        At a glance
      </p>
      <dl class="space-y-5">
        {
          facts.map((f) => (
            <div>
              <dt class="text-sm text-white/70">{f.label}</dt>
              <dd class="mt-0.5 text-[1.05rem] leading-snug font-medium">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<style>
  .glance {
    --cut: 64px;
    padding-bottom: calc(2.25rem + 20px);
  }
</style>
