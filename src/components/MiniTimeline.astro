---
/**
 * A thin bar on the same 2011 → now scale as the career bar, showing when
 * something was in use.
 */
import { experience, type Period } from '../data/cv';
import { toEndYear, toYear } from '../lib/dates';

interface Props {
  periods: Period[];
  color: string;
  label: string;
}
const { periods, color, label } = Astro.props;

const starts = experience.flatMap((j) => j.roles.map((r) => toYear(r.period.from)));
const first = Math.floor(Math.min(...starts));
const last = toYear(null);
const pct = (y: number) => ((y - first) / (last - first)) * 100;
---

<div class="mini" role="img" aria-label={label} style={`--c:${color}`}>
  {
    periods.map((p) => (
      <span
        class:list={['seg', { open: p.to === null }]}
        style={`left:${pct(toYear(p.from))}%;width:${pct(toEndYear(p.to)) - pct(toYear(p.from))}%`}
      />
    ))
  }
</div>

<style>
  .mini {
    position: relative;
    height: 8px;
    background: var(--line);
    border-radius: 1px;
  }
  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--c);
  }
  /* still in use: ends in the logo's 30° cut, like the career bar */
  .seg.open {
    clip-path: polygon(0 0, 100% 0, calc(100% - 4.6px) 100%, 0 100%);
  }
</style>
