---
/**
 * Three layers of what Kenny builds. One layer is "active" at a time; the hero
 * sentence and this stack stay in sync (see Hero.astro). Clicking a layer picks it.
 */
const files = import.meta.glob<string>('../assets/tech/*.svg', { eager: true, query: '?url', import: 'default' });
const logo = (n: string) => files[`../assets/tech/${n}.svg`];

const layers = [
  { id: 'frontend', name: 'Frontend', logos: ['angular', 'typescript', 'rxjs'], tone: 'mint' },
  { id: 'backend', name: 'Backend', logos: ['csharp', 'dotnet', 'sqlserver'], tone: 'red' },
  { id: 'ai', name: 'AI workflow', logos: ['claude'], tone: 'light' },
];
---

<div class="stack" data-stack>
  {
    [...layers].reverse().map((l) => (
      <button type="button" class:list={['layer cut-corner', l.tone]} data-layer={l.id} aria-pressed="false">
        <span class="name">{l.name}</span>
        <span class="logos" aria-hidden="true">
          {l.logos.map((n) => (
            <img src={logo(n)} alt="" width="26" height="26" />
          ))}
        </span>
      </button>
    ))
  }
</div>

<style>
  .stack {
    display: grid;
    gap: 12px;
  }
  .layer {
    --cut: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 1.5rem 1.45rem;
    background: rgb(255 255 255 / 0.06);
    color: rgb(255 255 255 / 0.55);
    font-weight: 700;
    font-size: 1.15rem;
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.45s,
      color 0.45s;
  }
  .logos {
    display: flex;
    gap: 0.6rem;
    opacity: 0.45;
    transition: opacity 0.45s;
  }
  .logos img {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }
  .layer[aria-pressed='true'] {
    transform: translateX(-18px);
    color: #1d2a26;
  }
  .layer[aria-pressed='true'] .logos {
    opacity: 1;
  }
  .layer.mint[aria-pressed='true'] {
    background: #7fd1b9;
  }
  .layer.red[aria-pressed='true'] {
    background: #ac3931;
    color: #fff;
  }
  .layer.light[aria-pressed='true'] {
    background: #f3f4f6;
  }
  .layer:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      transition: none;
    }
  }
</style>
