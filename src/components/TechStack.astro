---
/**
 * The main technologies as logo tiles. On hover or focus a tile fills with
 * the technology's own colour, cut in the logo's 30° corner.
 */
import { technologies } from '../data/site';

const files = import.meta.glob<string>('../assets/tech/*.svg', { eager: true, query: '?url', import: 'default' });
const src = (logo: string) => files[`../assets/tech/${logo}.svg`];
---

<section id="technologies" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <h2 class="mb-10 text-3xl font-extrabold tracking-tight md:text-4xl">Technologies I work with</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-5">
      {
        technologies.map((t) => (
          <li class="tile cut-corner" style={`--c:${t.color}`} tabindex="0">
            {t.mono ? (
              <span class="logo mask" style={`--src:url("${src(t.logo)}")`} aria-hidden="true" />
            ) : (
              <img class="logo" src={src(t.logo)} alt="" width="44" height="44" loading="lazy" />
            )}
            <span class="name">{t.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tile {
    --cut: 22px;
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.4rem 0.5rem 1.6rem;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    text-align: center;
  }
  .tile::before {
    /* colour wash in the technology's own colour */
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .tile:hover::before,
  .tile:focus-visible::before {
    opacity: 0.14;
  }
  .logo,
  .name {
    position: relative;
  }
  .logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }
  .mask {
    display: block;
    background: var(--ink);
    mask: var(--src) center / contain no-repeat;
  }
  .name {
    font-size: 0.95rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo {
      transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.4, 1.4);
    }
    .tile:hover .logo,
    .tile:focus-visible .logo {
      transform: scale(1.12) rotate(-4deg);
    }
  }
</style>
