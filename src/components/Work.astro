---
const areas = [
  {
    title: 'Frontend',
    accent: 'bg-mint',
    lead: 'Angular since the early days.',
    body: 'I rewrote Rydoo’s WebForms app into an Angular SPA, co-built its component library and later led the frontend on an Nx monorepo. At VAB I rebuilt and launched vab.be in Angular SSR. I care about code a team can keep working in.',
  },
  {
    title: 'Backend',
    accent: 'bg-red',
    lead: 'C# and .NET since 2012.',
    body: 'Web APIs, backend-for-frontend layers, SQL Server, Kafka, and integrations with whatever the business runs on: Exact Online, Dropbox, Sitecore, and at Citymesh a brand-new mobile network core.',
  },
  {
    title: 'Working with AI',
    accent: 'bg-ink',
    lead: 'The AI drafts, I decide what ships.',
    body: 'At Citymesh I designed the workflow our frontend rebuild runs on: a chain of Claude Code skills that takes each screen from analysis to a merged pull request, with a review at every step. Colleagues now come to me when they want to work this way too.',
  },
];
---

<section id="work" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <h2 class="mb-10 text-3xl font-extrabold tracking-tight md:text-4xl">What I do</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {
        areas.map((a) => (
          <article class="card cut-corner flex flex-col bg-surface">
            <span class:list={['h-2', a.accent]} aria-hidden="true" />
            <div class="flex flex-1 flex-col p-7 pb-10">
              <h3 class="text-sm font-semibold text-muted">{a.title}</h3>
              <p class="mt-2 text-xl leading-snug font-bold">{a.lead}</p>
              <p class="mt-4 leading-relaxed text-muted">{a.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .card {
    --cut: 40px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
