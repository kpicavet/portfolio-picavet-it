---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found, Picavet IT">
  <meta slot="head" name="robots" content="noindex" />
  <section class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">This page doesn’t exist</h1>
    <p class="mt-4 max-w-[50ch] text-lg text-muted">The link may be old or mistyped.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="rounded-md bg-red px-5 py-3 font-semibold text-white hover:bg-[#962f28]">Go to the homepage</a>
      <a href="/cv" class="rounded-md border border-ink/25 px-5 py-3 font-semibold hover:border-ink">View CV</a>
    </div>
  </section>
</Layout>
