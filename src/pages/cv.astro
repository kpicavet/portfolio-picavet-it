---
import '@fontsource-variable/archivo/standard.css';
import CareerBar from '../components/CareerBar.astro';
import { profile, experience, skills, education, learning } from '../data/cv';
import { formatPeriod, formatMonth } from '../lib/dates';

const pdfPath = '/kenny-picavet-cv.pdf';
// short skill groups go under Languages so both columns end at about the same height
const rightColumn = ['Domains'] as const;
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} – CV</title>
    <meta name="description" content={`CV of ${profile.name}, ${profile.headline}.`} />
    <link rel="canonical" href={new URL('/cv', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="toolbar" aria-label="CV actions">
      <a href="/">Back to picavet-it.com</a>
      <a href={pdfPath} download class="primary">Download PDF</a>
    </nav>

    <main class="sheet">
      <header class="head">
        <div class="id">
          <img src="/logo.svg" alt="Picavet IT logo" class="mark" width="54" height="72" />
          <div>
          <h1>{profile.name}</h1>
          <p class="headline">{profile.headline}</p>
          <p class="sub">Freelance, based in {profile.location}</p>
          </div>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a></li>
          <li><a href={profile.website}>{host(profile.website)}</a></li>
          <li><a href={profile.linkedin}>{host(profile.linkedin)}</a></li>
        </ul>
      </header>

      <p class="summary">{profile.summary}</p>

      <section class="timeline" aria-label="Career overview">
        <CareerBar compact />
        <p class="legend">
          <span class="key emp"></span>Employed
          <span class="key free"></span>Freelance
        </p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          experience.map((job) => (
            <article class="job">
              <div class="meta">
                <p class="company">{job.company}</p>
                <p>{job.location}</p>
                {job.freelance && <p>Freelance</p>}
              </div>
              <div class="body">
                {job.roles.map((role) => (
                  <h3>
                    {role.title}
                    <span class="period">{formatPeriod(role.period)}</span>
                  </h3>
                ))}
                <p>{job.summary}</p>
                {job.highlights.length > 0 && (
                  <ul class="highlights">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
                <p class="stack">{job.stack.join(', ')}</p>
              </div>
            </article>
          ))
        }
      </section>

      <section class="two-col">
        <div>
          <h2>Skills</h2>
          <dl class="skills">
            {
              Object.entries(skills).filter(([group]) => !rightColumn.includes(group)).map(([group, items]) => (
                <div>
                  <dt>{group}</dt>
                  <dd>{items.join(', ')}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h2>Education</h2>
          {
            education.map((e) => (
              <p class="item">
                <strong>{e.degree}</strong>
                <br />
                {e.school}, <span class="nowrap">{formatMonth(e.period.from).slice(-4)}–{e.period.to && formatMonth(e.period.to).slice(-4)}</span>
              </p>
            ))
          }
          <h2>Conferences</h2>
          <ul class="plain">
            {learning.map((l) => <li><span class="year">{l.year}</span>{l.title}</li>)}
          </ul>
          <h2>Languages</h2>
          <p class="item">{profile.languages.join(', ')}</p>
          {
            rightColumn.map((group) => (
              <>
                <h2>{group}</h2>
                <p class="item">{skills[group].join(', ')}</p>
              </>
            ))
          }
        </div>
      </section>
    </main>

    <style is:global>
      :root {
        --paper: #ffffff;
        --ink: #1d2a26;
        --muted: #56655f;
        --line: #d5ded9;
        --red: #ac3931;
        --mint: #7fd1b9;
        --mint-deep: #2f7d68;
        --bg: #e8eeeb;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Archivo Variable', system-ui, sans-serif;
        font-size: 10pt;
        line-height: 1.45;
        /* a touch of extra word space so PDF text extraction keeps words apart */
        word-spacing: 0.03em;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      body {
        margin: 0;
        padding: 16px;
      }
      a {
        color: inherit;
        text-decoration-color: var(--mint);
        text-underline-offset: 2px;
      }
      a:focus-visible {
        outline: 2px solid var(--red);
        outline-offset: 2px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .toolbar {
        max-width: 210mm;
        margin: 0 auto 12px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 11pt;
      }
      .toolbar a {
        padding: 8px 14px;
        border-radius: 6px;
        text-decoration: none;
      }
      .toolbar .primary {
        background: var(--red);
        color: #fff;
        font-weight: 600;
      }

      .sheet {
        max-width: 210mm;
        margin: 0 auto;
        padding: 16mm 16mm 14mm;
        background: var(--paper);
        box-shadow: 0 1px 3px rgb(29 42 38 / 0.12);
      }

      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        flex-wrap: wrap;
      }
      .id {
        display: flex;
        align-items: center;
        gap: 5mm;
      }
      .mark {
        height: 19mm;
        width: auto;
      }
      h1 {
        margin: 0;
        font-size: 30pt;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -0.015em;
        word-spacing: 0.12em;
        color: var(--red);
      }
      .headline {
        margin: 6px 0 0;
        font-size: 13pt;
        font-weight: 600;
      }
      .sub {
        margin: 2px 0 0;
        color: var(--muted);
      }
      .contact {
        list-style: none;
        margin: 0;
        padding: 0;
        text-align: right;
        font-size: 9pt;
      }
      .summary {
        margin: 7mm 0 6mm;
        font-size: 10.5pt;
        max-width: 68ch;
      }

      .timeline {
        margin-bottom: 4mm;
      }
      .legend {
        margin: 2px 0 0;
        font-size: 8pt;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .key {
        display: inline-block;
        width: 10px;
        height: 6px;
      }
      .key.emp {
        background: var(--red);
      }
      .key.free {
        background: var(--mint);
        margin-left: 10px;
      }

      h2 {
        margin: 5mm 0 2.5mm;
        padding-bottom: 1.5mm;
        font-size: 12pt;
        font-weight: 750;
        border-bottom: 2px solid var(--ink);
      }

      .job {
        display: grid;
        grid-template-columns: 30mm 1fr;
        gap: 0 6mm;
        padding: 3mm 0;
      }
      /* long jobs may continue on the next page, but never mid-line:
         role titles, bullets and the stack line stay whole */
      .job h3,
      .job li,
      .job .stack,
      .job .body > p {
        break-inside: avoid;
      }
      .job .body > h3:first-child {
        break-after: avoid;
      }
      .job + .job {
        border-top: 1px solid var(--line);
      }
      .meta p {
        margin: 0;
        color: var(--muted);
        font-size: 9pt;
      }
      .meta .company {
        color: var(--ink);
        font-size: 11pt;
        font-weight: 700;
      }
      h3 {
        margin: 0 0 1mm;
        font-size: 10.5pt;
        font-weight: 650;
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }
      .period {
        font-weight: 400;
        color: var(--muted);
        font-size: 9pt;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .body > p {
        margin: 1.5mm 0;
      }
      .highlights {
        margin: 1.5mm 0;
        padding-left: 0;
        list-style: none;
      }
      /*
        Bullet: a tiny logo stem ending in a 30° cut, painted as the li's own
        background. No positioning and no clip-path on purpose: positioned or
        clipped boxes are painted in a later pass, and the PDF text then comes
        out in the wrong order for ATS parsers.
      */
      .highlights li {
        padding-left: 12px;
        margin: 1mm 0;
        background:
          linear-gradient(var(--red), var(--red)) 0 0.42em / 3.5px 6px no-repeat,
          linear-gradient(to bottom right, var(--red) 50%, transparent 50%) 0 calc(0.42em + 6px) / 3.5px 2px no-repeat;
      }
      .stack {
        color: var(--mint-deep);
        font-size: 9pt;
      }

      .two-col {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 0 10mm;
      }
      /* the block may start on one page and continue on the next,
         but a heading never ends a page and a skill group stays whole */
      .two-col h2 {
        break-after: avoid;
      }
      .skills div,
      .plain li {
        break-inside: avoid;
      }
      .skills {
        margin: 0;
      }
      .skills div {
        margin-bottom: 2.5mm;
      }
      .skills dt {
        font-weight: 650;
      }
      .skills dd {
        margin: 0;
        font-size: 9.5pt;
      }
      .nowrap {
        white-space: nowrap;
      }
      .item {
        margin: 0 0 2mm;
      }
      .plain {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .plain li {
        display: flex;
        gap: 8px;
        margin-bottom: 1.5mm;
      }
      .year {
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }

      @media (max-width: 640px) {
        .sheet {
          padding: 20px 16px;
        }
        .contact {
          text-align: left;
        }
        .job,
        .two-col {
          grid-template-columns: 1fr;
        }
        .meta {
          display: flex;
          gap: 8px;
          align-items: baseline;
          margin-bottom: 4px;
        }
        h3 {
          flex-direction: column;
          gap: 0;
        }
      }

      /* margins on @page so every page (not just the first) gets them */
      @page {
        size: A4;
        margin: 11mm 15mm 10mm;
      }
      @media print {
        html {
          background: #fff;
        }
        body {
          padding: 0;
        }
        .toolbar {
          display: none;
        }
        .sheet {
          max-width: none;
          box-shadow: none;
          padding: 0;
        }
        a {
          text-decoration: none;
        }
      }
    </style>
  </body>
</html>
