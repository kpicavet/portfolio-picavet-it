---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message sent, Picavet IT">
  <meta slot="head" name="robots" content="noindex" />
  <section class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Message sent</h1>
    <p class="mt-4 max-w-[50ch] text-lg text-muted">Thanks for getting in touch. I’ll reply by email.</p>
    <a href="/" class="mt-8 inline-block font-semibold text-accent-text underline underline-offset-4">Back to the homepage</a>
  </section>
</Layout>
